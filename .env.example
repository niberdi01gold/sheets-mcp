# --- Option 1 (recommended): service account -------------------------------
# Create a service account in Google Cloud, enable the Sheets API and the Drive
# API, download the JSON key, then SHARE each spreadsheet with the service
# account's client_email address.
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json

# Same key inlined as JSON, for hosts where you cannot mount a file.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- Option 2: OAuth as yourself -------------------------------------------
# Uses your own Google account instead of a service account. Run `sheets-mcp auth`
# once in a terminal to authorize; the token is cached at ~/.sheets-mcp/token.json
# GOOGLE_OAUTH_CLIENT_FILE=/absolute/path/to/oauth-client.json
# GOOGLE_OAUTH_TOKEN_FILE=~/.sheets-mcp/token.json

# --- Behaviour --------------------------------------------------------------
# When true, the write tools are not registered at all and the model cannot see them.
SHEETS_MCP_READ_ONLY=false
